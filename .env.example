# copy to .env (docker compose reads it automatically)
JWT_SECRET=change-me-to-a-long-random-string
# Optional LLM providers for the assistant (falls back to an extractive answer if neither is set)
ANTHROPIC_API_KEY=
OLLAMA_URL=            # e.g. http://ollama:11434 when running with --profile llm
OLLAMA_MODEL=llama3.2