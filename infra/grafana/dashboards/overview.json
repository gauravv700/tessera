{
 "uid": "trading-overview",
 "title": "Trading platform overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Orders / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (symbol) (rate(orders_placed_total[1m]))",
     "legendFormat": "{{symbol}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Trades / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (symbol) (rate(trades_executed_total[1m]))",
     "legendFormat": "{{symbol}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Matching latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(matching_latency_seconds_bucket[1m])))",
     "legendFormat": "{{symbol}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "WebSocket connections",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ws_connections)",
     "legendFormat": "{{symbol}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "AI calls by result",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (result) (rate(ai_calls_total[1m]))",
     "legendFormat": "{{symbol}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Anomalies flagged",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(anomalies_flagged_total[5m])",
     "legendFormat": "{{symbol}}"
    }
   ]
  }
 ]
}